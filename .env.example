# Hostname only, without https://, a port, or a trailing slash.
DOMAIN=draw.example.com

# Required for make ssl; registration agrees to the Let's Encrypt terms.
SSL_EMAIL=

# Generate with: openssl rand -hex 32
# Use hex to keep the PostgreSQL connection URI valid without percent-encoding.
POSTGRES_PASSWORD=

# Directory containing your existing certificate and private key.
CERTS_DIR=./certs
# Certbot stores certificates under live/ and archive/ in CERTS_DIR.
# For existing certificates, you can use their relative filenames instead.
TLS_CERT_FILE=live/${DOMAIN}/fullchain.pem
TLS_KEY_FILE=live/${DOMAIN}/privkey.pem
